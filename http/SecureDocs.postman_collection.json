    {
      "name": "1 · Auth: flujo básico",
      "description": "Ejecútalos en orden: el login guarda el token y los demás lo usan.",
      "item": [
        {
          "name": "Empleado · FINANZAS · nivel 3 (Eduardo)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test(\"devuelve un JWT (3 partes)\", () => pm.expect(json.token.split(\".\")).to.have.lengthOf(3));",
                  "pm.test(\"rol = EMPLEADO\", () => pm.expect(json.usuario.rol).to.eql(\"EMPLEADO\"));",
                  "pm.test(\"estado = ACTIVO\", () => pm.expect(json.usuario.estado).to.eql(\"ACTIVO\"));",
                  "pm.test(\"no expone el hash de la contraseña\", () => pm.expect(JSON.stringify(json)).to.not.include(\"password_hash\"));",
                  "pm.environment.set(\"token\", json.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "empleado.fin@techcorp.pe\n\nCasos 1, 2, 4, 15. Es propietario de varios documentos de FINANZAS.\n\nGuarda el token en la variable {{token}}: los demás requests lo usan solos.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"empleado.fin@techcorp.pe\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Me · con token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test(\"trae usuario y entorno\", () => { pm.expect(json).to.have.property(\"usuario\"); pm.expect(json).to.have.property(\"entorno\"); });",
                  "pm.test(\"el entorno refleja X-Ubicacion y X-Dispositivo\", () => {",
                  "  pm.expect(json.entorno.ubicacion).to.eql(String(pm.environment.get(\"ubicacion\")).toUpperCase());",
                  "  pm.expect(json.entorno.dispositivo).to.eql(String(pm.environment.get(\"dispositivo\")).toUpperCase());",
                  "});",
                  "pm.test(\"hora con formato HH:mm\", () => pm.expect(json.entorno.hora).to.match(/^\\d{2}:\\d{2}$/));",
                  "pm.test(\"no expone el hash de la contraseña\", () => pm.expect(JSON.stringify(json)).to.not.include(\"password_hash\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Ubicacion",
                "value": "{{ubicacion}}",
                "type": "text",
                "description": "País simulado desde el que se accede (PERU, CHILE...). Lo evalúa la política P5."
              },
              {
                "key": "X-Dispositivo",
                "value": "{{dispositivo}}",
                "type": "text",
                "description": "CORPORATIVO o PERSONAL. Lo evalúa la política P6."
              },
              {
                "key": "X-Hora",
                "value": "{{hora}}",
                "type": "text",
                "disabled": true,
                "description": "Hora simulada HH:mm (solo con NODE_ENV distinto de production). Actívalo y escribe la hora en la variable 'hora'. Lo evalúa la política P4."
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            },
            "description": "Devuelve el usuario (leído de la BD) y el entorno tal como lo ve el servidor."
          }
        },
