    {
      "name": "3 · Login rápido por usuario",
      "description": "Un login por cada usuario del seed (contraseña común en la variable {{password}}). Ejecuta el que quieras probar y el token queda en {{token}}.",
      "item": [
        {
          "name": "Admin · GLOBAL · nivel 5",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
